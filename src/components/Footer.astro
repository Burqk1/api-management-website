---
const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Pricing', href: '/#pricing' },
      { label: 'Changelog', href: '/changelog' },
      { label: 'Download', href: '/download' },
      { label: 'Security', href: '/security' },
    ],
  },
  {
    title: 'Features',
    links: [
      { label: 'API Testing', href: '/#showcase' },
      { label: '78+ Tools', href: '/#features' },
      { label: 'GraphQL', href: '/graphql' },
      { label: 'Scripts', href: '/scripts' },
      { label: 'Cloud Sync', href: '/cloud-sync' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Customers', href: '/customers' },
      { label: 'Blog', href: '/blog' },
      { label: 'Careers', href: '/careers' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Documentation', href: '/docs' },
      { label: 'FAQ', href: '/#faq' },
      { label: 'Support', href: '/support' },
      { label: 'Status', href: '/status' },
    ],
  },
  {
    title: 'Connect',
    links: [
      { label: 'Contact', href: '/contact' },
      { label: 'X (Twitter)', href: 'https://twitter.com/fetchlab' },
      { label: 'GitHub', href: 'https://github.com/fetchlab' },
      { label: 'Discord', href: 'https://discord.gg/fetchlab' },
    ],
  },
];
---

<footer class="border-t border-[#1a1a1d] pt-14 pb-8 px-6">
  <div class="max-w-container mx-auto">
    <div class="mb-10">
      <a href="/" class="inline-flex items-center gap-2 opacity-40 hover:opacity-60 transition-opacity">
        <img src="/logo.jpg" alt="Fetchlab" class="w-[18px] h-[18px] rounded-[4px]" />
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 mb-14">
      {columns.map((col) => (
        <div>
          <h4 class="text-[12px] font-medium text-[#8B8B8B] mb-3.5">{col.title}</h4>
          <ul class="space-y-2">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-[13px] text-[#5C5C5C] hover:text-[#8B8B8B] transition-colors duration-200">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex items-center gap-4 border-t border-[#1a1a1d] pt-6">
      <a href="/privacy" class="text-[11px] text-[#3A3A3E] hover:text-[#5C5C5C] transition-colors">Privacy Policy</a>
      <a href="/terms" class="text-[11px] text-[#3A3A3E] hover:text-[#5C5C5C] transition-colors">Terms of Service</a>
    </div>
  </div>
</footer>
