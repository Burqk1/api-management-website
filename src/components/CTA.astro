<section class="py-[140px] sm:py-[180px] px-6 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.04) 1px, transparent 0); background-size: 32px 32px; mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, black 10%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, black 10%, transparent 70%);" class="absolute inset-0"></div>
  </div>

  <div class="relative z-10 max-w-container mx-auto text-center">
    <div class="observe">
      <h2 class="text-[40px] sm:text-[56px] lg:text-[72px] font-medium tracking-[-0.04em] leading-[1.05] text-[#F5F5F5] mb-4">
        Start testing today.
      </h2>
      <p class="text-[16px] text-[#5C5C5C] mb-10 max-w-[400px] mx-auto">
        Free to download. No account required.
      </p>
      <div class="flex items-center justify-center gap-3">
        <a href="#" class="cta-btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          Download for iOS
        </a>
        <a href="#features" class="cta-btn-ghost">
          Learn more
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    background: #F5F5F5;
    color: #0A0A0B;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    transition: opacity 0.15s ease, transform 0.1s ease;
  }
  .cta-btn-primary:hover { opacity: 0.9; }
  .cta-btn-primary:active { transform: scale(0.98); }
  .cta-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #8B8B8B;
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .cta-btn-ghost:hover {
    color: #F5F5F5;
    border-color: rgba(255, 255, 255, 0.25);
  }
</style>
