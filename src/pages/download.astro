---
import Base from '../layouts/Base.astro';
---

<Base title="Download — Fetchlab" description="Download Fetchlab for iOS. Professional API testing on your iPhone.">
  <div class="pt-28 pb-20 px-6">
    <div class="max-w-[680px] mx-auto text-center">
      <h1 class="text-[32px] sm:text-[48px] font-medium tracking-[-0.04em] text-[#F5F5F5] mb-4">Download Fetchlab</h1>
      <p class="text-[16px] text-[#5C5C5C] mb-12 max-w-[440px] mx-auto">
        Professional API testing, built for iOS. Free to download, no account required.
      </p>

      <!-- App Store button -->
      <a href="#" class="inline-flex items-center gap-3 px-8 py-4 bg-[#F5F5F5] text-[#0A0A0B] rounded-xl font-semibold text-[15px] hover:opacity-90 transition-opacity active:scale-[0.98] mb-16">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        Download on the App Store
      </a>

      <!-- System requirements -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-[#1E1E21] rounded-xl overflow-hidden border border-[#1E1E21]">
        <div class="bg-[#0A0A0B] p-6 text-center">
          <div class="text-[13px] text-[#5C5C5C] mb-1">Platform</div>
          <div class="text-[15px] text-[#F5F5F5] font-medium">iOS 16+</div>
        </div>
        <div class="bg-[#0A0A0B] p-6 text-center">
          <div class="text-[13px] text-[#5C5C5C] mb-1">Size</div>
          <div class="text-[15px] text-[#F5F5F5] font-medium">28 MB</div>
        </div>
        <div class="bg-[#0A0A0B] p-6 text-center">
          <div class="text-[13px] text-[#5C5C5C] mb-1">Price</div>
          <div class="text-[15px] text-[#F5F5F5] font-medium">Free</div>
        </div>
      </div>
    </div>
  </div>
</Base>
