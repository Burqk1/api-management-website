---
import Base from '../layouts/Base.astro';
---

<Base title="Contact — Fetchlab" description="Get in touch with the Fetchlab team. Support, partnerships, and general inquiries.">
  <div class="pt-28 pb-20 px-6">
    <div class="max-w-[680px] mx-auto">
      <h1 class="text-[32px] sm:text-[40px] font-medium tracking-[-0.04em] text-[#F5F5F5] mb-3">Contact</h1>
      <p class="text-[15px] text-[#5C5C5C] mb-10 max-w-[480px]">
        Have a question, want to report a bug, or just want to say hi? Send us a message below.
      </p>

      <!-- Contact Form -->
      <div class="bg-[#111113] border border-[#1E1E21] rounded-xl p-6 sm:p-8 mb-10">
        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[12px] text-[#5C5C5C] mb-1.5 font-medium">Name</label>
              <input type="text" id="cf-name" required placeholder="Your name" class="contact-input" />
            </div>
            <div>
              <label class="block text-[12px] text-[#5C5C5C] mb-1.5 font-medium">Email</label>
              <input type="email" id="cf-email" required placeholder="you@example.com" class="contact-input" />
            </div>
          </div>

          <div>
            <label class="block text-[12px] text-[#5C5C5C] mb-1.5 font-medium">Subject</label>
            <select id="cf-subject" class="contact-input cursor-pointer">
              <option value="support">Support — Bug reports & help</option>
              <option value="general">General — Partnerships & press</option>
              <option value="feature">Feature Request</option>
              <option value="security">Security — Responsible disclosure</option>
              <option value="careers">Careers — Join the team</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label class="block text-[12px] text-[#5C5C5C] mb-1.5 font-medium">Message</label>
            <textarea id="cf-message" required rows="6" placeholder="Tell us what's on your mind..." class="contact-input resize-none"></textarea>
          </div>

          <button type="submit" id="cf-submit" class="w-full sm:w-auto px-6 py-2.5 bg-[#F5F5F5] text-[#0A0A0B] text-[14px] font-semibold rounded-lg hover:opacity-90 transition-opacity border-none cursor-pointer">
            Send Message
          </button>

          <div id="cf-success" class="hidden text-[13px] text-green-400 bg-green-400/10 border border-green-400/20 rounded-lg px-4 py-3">
            Message sent successfully! We'll get back to you within 24 hours.
          </div>
          <div id="cf-error" class="hidden text-[13px] text-red-400 bg-red-400/10 border border-red-400/20 rounded-lg px-4 py-3"></div>
        </form>
      </div>

      <!-- Quick contact cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10">
        <a href="mailto:support@fetchlab.dev" class="bg-[#111113] border border-[#1E1E21] rounded-xl p-5 group hover:border-[#2A2A2E] transition-colors text-center">
          <div class="text-[#5C5C5C] mb-2 flex justify-center group-hover:text-[#8B8B8B] transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3 class="text-[13px] font-medium text-[#F5F5F5] mb-0.5">Support</h3>
          <span class="text-[11px] text-[#FF9500]">support@fetchlab.dev</span>
        </a>

        <a href="mailto:hello@fetchlab.dev" class="bg-[#111113] border border-[#1E1E21] rounded-xl p-5 group hover:border-[#2A2A2E] transition-colors text-center">
          <div class="text-[#5C5C5C] mb-2 flex justify-center group-hover:text-[#8B8B8B] transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="text-[13px] font-medium text-[#F5F5F5] mb-0.5">General</h3>
          <span class="text-[11px] text-[#FF9500]">hello@fetchlab.dev</span>
        </a>

        <a href="mailto:security@fetchlab.dev" class="bg-[#111113] border border-[#1E1E21] rounded-xl p-5 group hover:border-[#2A2A2E] transition-colors text-center">
          <div class="text-[#5C5C5C] mb-2 flex justify-center group-hover:text-[#8B8B8B] transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="text-[13px] font-medium text-[#F5F5F5] mb-0.5">Security</h3>
          <span class="text-[11px] text-[#FF9500]">security@fetchlab.dev</span>
        </a>
      </div>

      <!-- Social -->
      <div class="border-t border-[#1E1E21] pt-8">
        <h2 class="text-[13px] font-medium text-[#8B8B8B] mb-4">Find us online</h2>
        <div class="flex items-center gap-4">
          <a href="https://twitter.com/fetchlab" class="text-[13px] text-[#5C5C5C] hover:text-[#8B8B8B] transition-colors">X (Twitter)</a>
          <a href="https://github.com/fetchlab" class="text-[13px] text-[#5C5C5C] hover:text-[#8B8B8B] transition-colors">GitHub</a>
          <a href="https://discord.gg/fetchlab" class="text-[13px] text-[#5C5C5C] hover:text-[#8B8B8B] transition-colors">Discord</a>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .contact-input {
    width: 100%;
    padding: 10px 14px;
    background: #0A0A0B;
    border: 1px solid #1E1E21;
    border-radius: 8px;
    color: #F5F5F5;
    font-size: 14px;
    outline: none;
    transition: border-color 0.15s ease;
    font-family: inherit;
  }
  .contact-input:focus {
    border-color: #3A3A3E;
  }
  .contact-input::placeholder {
    color: #3A3A3E;
  }
  .contact-input option {
    background: #111113;
    color: #F5F5F5;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('cf-success')!;
  const errorMsg = document.getElementById('cf-error')!;
  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    const name = (document.getElementById('cf-name') as HTMLInputElement).value;
    const email = (document.getElementById('cf-email') as HTMLInputElement).value;
    const subject = (document.getElementById('cf-subject') as HTMLSelectElement).value;
    const message = (document.getElementById('cf-message') as HTMLTextAreaElement).value;

    try {
      const { error } = await supabase
        .from('contact_messages')
        .insert([{ name, email, subject, message, created_at: new Date().toISOString() }]);

      if (error) throw error;

      successMsg.classList.remove('hidden');
      form.reset();
      submitBtn.textContent = 'Sent!';
      setTimeout(() => { submitBtn.textContent = 'Send Message'; submitBtn.disabled = false; }, 3000);
    } catch (err: any) {
      // Fallback: mailto link if Supabase table doesn't exist yet
      const mailSubjects: Record<string, string> = {
        support: 'Support Request',
        general: 'General Inquiry',
        feature: 'Feature Request',
        security: 'Security Report',
        careers: 'Career Application',
        other: 'Contact',
      };
      const mailTo = subject === 'security' ? 'security@fetchlab.dev' : subject === 'careers' ? 'careers@fetchlab.dev' : 'support@fetchlab.dev';
      const mailSubject = encodeURIComponent(`[Fetchlab] ${mailSubjects[subject] || 'Contact'}`);
      const mailBody = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);

      window.location.href = `mailto:${mailTo}?subject=${mailSubject}&body=${mailBody}`;

      submitBtn.textContent = 'Send Message';
      submitBtn.disabled = false;
    }
  });
</script>
