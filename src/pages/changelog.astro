---
import Base from '../layouts/Base.astro';

const entries = [
  {
    version: '1.4.0',
    date: 'March 12, 2026',
    tag: 'Latest',
    changes: [
      { type: 'new', text: 'AI-powered response analysis with smart suggestions' },
      { type: 'new', text: 'WebSocket testing support' },
      { type: 'improved', text: 'Script editor with syntax highlighting and autocomplete' },
      { type: 'fixed', text: 'Collection import failing for large Postman files' },
    ],
  },
  {
    version: '1.3.2',
    date: 'February 28, 2026',
    changes: [
      { type: 'improved', text: 'Response time graph rendering performance' },
      { type: 'fixed', text: 'Cloud sync conflict resolution edge case' },
      { type: 'fixed', text: 'Dark mode inconsistencies on Settings page' },
    ],
  },
  {
    version: '1.3.0',
    date: 'February 15, 2026',
    changes: [
      { type: 'new', text: 'GraphQL introspection and schema browser' },
      { type: 'new', text: 'Environment variable groups' },
      { type: 'improved', text: 'Request body editor with JSON validation' },
      { type: 'improved', text: 'Faster collection loading for 500+ requests' },
    ],
  },
  {
    version: '1.2.0',
    date: 'January 20, 2026',
    changes: [
      { type: 'new', text: 'Pre/Post request scripts with Postman compatibility' },
      { type: 'new', text: 'cURL import and export' },
      { type: 'improved', text: 'Response diff view with side-by-side comparison' },
      { type: 'fixed', text: 'OAuth2 token refresh not working with certain providers' },
    ],
  },
  {
    version: '1.1.0',
    date: 'December 8, 2025',
    changes: [
      { type: 'new', text: 'End-to-end encrypted cloud sync' },
      { type: 'new', text: '40+ developer tools (encoding, hashing, generation)' },
      { type: 'improved', text: 'Collection sidebar with drag-and-drop reordering' },
    ],
  },
  {
    version: '1.0.0',
    date: 'November 1, 2025',
    changes: [
      { type: 'new', text: 'Initial release of Fetchlab on the App Store' },
      { type: 'new', text: 'REST API testing with full method support' },
      { type: 'new', text: 'Request collections and environments' },
      { type: 'new', text: 'Response viewer with syntax highlighting' },
    ],
  },
];

const typeColors: Record<string, { bg: string; text: string; label: string }> = {
  new: { bg: 'bg-green-500/10', text: 'text-green-400', label: 'New' },
  improved: { bg: 'bg-blue-500/10', text: 'text-blue-400', label: 'Improved' },
  fixed: { bg: 'bg-amber-500/10', text: 'text-amber-400', label: 'Fixed' },
};
---

<Base title="Changelog — Fetchlab" description="See what's new in Fetchlab. Latest features, improvements, and bug fixes.">
  <div class="pt-28 pb-20 px-6">
    <div class="max-w-[680px] mx-auto">
      <h1 class="text-[32px] sm:text-[40px] font-medium tracking-[-0.04em] text-[#F5F5F5] mb-3">Changelog</h1>
      <p class="text-[15px] text-[#5C5C5C] mb-14">New updates and improvements to Fetchlab.</p>

      <div class="space-y-0">
        {entries.map((entry, i) => (
          <div class={`relative pl-8 pb-12 ${i < entries.length - 1 ? 'border-l border-[#1E1E21]' : 'border-l border-transparent'}`}>
            <!-- Dot -->
            <div class={`absolute left-0 top-1 w-2 h-2 rounded-full -translate-x-1/2 ${i === 0 ? 'bg-accent' : 'bg-[#2A2A2E]'}`}></div>

            <div class="flex items-center gap-3 mb-4">
              <span class="text-[15px] font-medium text-[#F5F5F5]">v{entry.version}</span>
              {entry.tag && (
                <span class="px-2 py-0.5 text-[10px] font-medium bg-accent/10 text-accent rounded-full">{entry.tag}</span>
              )}
              <span class="text-[13px] text-[#3A3A3E]">{entry.date}</span>
            </div>

            <ul class="space-y-2">
              {entry.changes.map((change) => (
                <li class="flex items-start gap-2.5">
                  <span class={`px-1.5 py-0.5 text-[10px] font-medium rounded ${typeColors[change.type].bg} ${typeColors[change.type].text} mt-0.5 shrink-0`}>
                    {typeColors[change.type].label}
                  </span>
                  <span class="text-[13px] text-[#8B8B8B] leading-relaxed">{change.text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
