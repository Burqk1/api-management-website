---
import ToolPage from '../../../layouts/ToolPage.astro';
---
<ToolPage title="Team Sync" description="Share collections and environments with your team" color="#3B82F6">
  <div class="db-card mb-4">
    <div class="db-card-header">Team Members</div>
    <div class="text-white/15 text-center py-6 text-[13px] mb-4">No team members yet.</div>
    <div class="flex gap-2"><input type="email" placeholder="teammate@company.com" class="flex-1 p-2.5 bg-[#09090B] border border-white/[0.06] rounded-lg text-[13px] text-white/60 outline-none" /><button class="px-4 py-2.5 bg-blue-500 text-white text-[12px] font-semibold rounded-lg hover:bg-blue-600 transition-colors border-none cursor-pointer">Invite</button></div>
  </div>
  <div class="db-card"><div class="db-card-header">Shared Collections</div><div class="text-white/15 text-center py-8 text-[13px]">Share a collection to enable real-time collaboration.</div></div>
</ToolPage>
