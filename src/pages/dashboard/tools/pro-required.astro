---
import Dashboard from '../../../layouts/Dashboard.astro';
---

<Dashboard title="Upgrade to Pro" activeTab="tools">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <!-- Glow effect -->
    <div class="relative mb-8">
      <div class="absolute inset-0 blur-[60px] bg-gradient-to-r from-orange-500/20 to-amber-500/20 rounded-full"></div>
      <div class="relative w-20 h-20 rounded-3xl bg-gradient-to-br from-[#FF9500] to-[#FF6B00] flex items-center justify-center shadow-2xl shadow-orange-500/30">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      </div>
    </div>

    <h1 class="text-[28px] font-bold tracking-[-0.03em] text-white mb-3">
      <span data-i18n="pro.title">Upgrade to</span> <span class="bg-gradient-to-r from-[#FF9500] to-[#FFB340] bg-clip-text text-transparent" data-i18n="pro.pro">Pro</span>
    </h1>
    <p class="text-[15px] text-white/35 max-w-[420px] mb-8 leading-relaxed" data-i18n="pro.desc">
      This feature requires a Pro subscription. Unlock all 78+ tools, AI analysis, unlimited requests, and encrypted cloud sync.
    </p>

    <!-- Feature highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-[600px] w-full mb-10">
      <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 text-left">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-3">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="text-[13px] font-semibold text-white/80 mb-1" data-i18n="pro.unlimited">Unlimited Requests</div>
        <div class="text-[11px] text-white/25" data-i18n="pro.unlimitedDesc">No daily limits on API calls</div>
      </div>
      <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 text-left">
        <div class="w-8 h-8 rounded-lg bg-violet-500/10 flex items-center justify-center mb-3">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7z"/></svg>
        </div>
        <div class="text-[13px] font-semibold text-white/80 mb-1" data-i18n="pro.tools">78+ Pro Tools</div>
        <div class="text-[11px] text-white/25" data-i18n="pro.toolsDesc">WebSocket, GraphQL, AI, and more</div>
      </div>
      <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 text-left">
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center mb-3">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div class="text-[13px] font-semibold text-white/80 mb-1" data-i18n="pro.sync">Encrypted Sync</div>
        <div class="text-[11px] text-white/25" data-i18n="pro.syncDesc">E2E encrypted cloud backup</div>
      </div>
    </div>

    <!-- CTA -->
    <div class="flex items-center gap-3">
      <a href="/#pricing" class="px-6 py-3 bg-gradient-to-r from-[#FF9500] to-[#FF7A00] text-white text-[14px] font-semibold rounded-xl hover:opacity-90 transition-opacity shadow-lg shadow-orange-500/25" data-i18n="pro.upgrade">
        Upgrade to Pro — $9.99/mo
      </a>
      <a href="/dashboard/tools" class="px-5 py-3 text-[14px] text-white/40 hover:text-white/70 transition-colors font-medium" data-i18n="pro.back">
        Go back
      </a>
    </div>

    <p class="text-[11px] text-white/15 mt-6" data-i18n="pro.trial">7-day free trial included. Cancel anytime.</p>
  </div>
</Dashboard>
