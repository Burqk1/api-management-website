---
import ToolPage from '../../../layouts/ToolPage.astro';
---
<ToolPage title="SSL Certificates" description="Manage client certificates and CA bundles for API requests" color="#3B82F6">
  <div class="db-card mb-4">
    <div class="db-card-header">Certificate Configuration</div>
    <div class="space-y-3 mb-4">
      <div><label class="text-[11px] text-white/25 font-medium uppercase tracking-wider mb-2 block">Client Certificate (PEM)</label><textarea rows="4" class="w-full p-3 bg-[#09090B] border border-white/[0.06] rounded-lg font-mono text-[11px] text-white/40 resize-none outline-none" placeholder="-----BEGIN CERTIFICATE-----"></textarea></div>
      <div><label class="text-[11px] text-white/25 font-medium uppercase tracking-wider mb-2 block">Private Key (PEM)</label><textarea rows="4" class="w-full p-3 bg-[#09090B] border border-white/[0.06] rounded-lg font-mono text-[11px] text-white/40 resize-none outline-none" placeholder="-----BEGIN PRIVATE KEY-----"></textarea></div>
      <div><label class="text-[11px] text-white/25 font-medium uppercase tracking-wider mb-2 block">Passphrase (optional)</label><input type="password" class="w-full p-2.5 bg-[#09090B] border border-white/[0.06] rounded-lg text-[13px] text-white/60 outline-none" placeholder="••••••" /></div>
    </div>
    <button class="px-5 py-2.5 bg-blue-500 text-white text-[13px] font-semibold rounded-lg hover:bg-blue-600 transition-colors border-none cursor-pointer">Save Certificate</button>
  </div>
</ToolPage>
