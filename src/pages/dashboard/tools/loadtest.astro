---
import ToolPage from '../../../layouts/ToolPage.astro';
---

<ToolPage title="Load Testing" description="Stress test your APIs with configurable concurrent requests" color="#F97316">
  <div class="db-card mb-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
      <div class="md:col-span-2">
        <label class="text-[11px] text-white/25 font-medium uppercase tracking-wider mb-2 block">Target URL</label>
        <input type="text" id="lt-url" placeholder="https://api.example.com/v1/health" class="db-input w-full font-mono text-[13px]" />
      </div>
      <div>
        <label class="text-[11px] text-white/25 font-medium uppercase tracking-wider mb-2 block">Duration (seconds)</label>
        <input type="number" id="lt-duration" value="10" min="1" max="60" class="db-input w-full" />
      </div>
      <div>
        <label class="text-[11px] text-white/25 font-medium uppercase tracking-wider mb-2 block">Concurrent Users</label>
        <input type="number" id="lt-users" value="10" min="1" max="100" class="db-input w-full" />
      </div>
    </div>
    <button id="lt-start" class="px-5 py-2.5 bg-orange-500 text-white text-[13px] font-semibold rounded-lg hover:bg-orange-600 transition-colors border-none cursor-pointer w-full">Start Load Test</button>
  </div>

  <div class="db-card hidden" id="lt-results">
    <div class="db-card-header">Live Results</div>
    <div class="grid grid-cols-4 gap-4 mb-4">
      <div class="text-center"><div class="text-[22px] font-bold text-white" id="lt-rps">0</div><div class="text-[10px] text-white/25 mt-1">Req/sec</div></div>
      <div class="text-center"><div class="text-[22px] font-bold text-white" id="lt-total">0</div><div class="text-[10px] text-white/25 mt-1">Total</div></div>
      <div class="text-center"><div class="text-[22px] font-bold text-emerald-400" id="lt-ok">0</div><div class="text-[10px] text-white/25 mt-1">Success</div></div>
      <div class="text-center"><div class="text-[22px] font-bold text-red-400" id="lt-err">0</div><div class="text-[10px] text-white/25 mt-1">Failed</div></div>
    </div>
    <div class="h-2 rounded-full bg-white/[0.06] overflow-hidden"><div class="h-full bg-gradient-to-r from-orange-500 to-amber-500 rounded-full transition-all" id="lt-bar" style="width:0%"></div></div>
    <div class="text-[11px] text-white/20 mt-2 text-center" id="lt-status"></div>
  </div>
</ToolPage>

<style>.db-input{padding:9px 12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;color:#FAFAFA;font-size:13px;outline:none}.db-input:focus{border-color:rgba(255,255,255,0.15)}.db-input::placeholder{color:rgba(255,255,255,0.15)}</style>

<script>
  document.getElementById('lt-start')!.addEventListener('click', async () => {
    const url = (document.getElementById('lt-url') as HTMLInputElement).value;
    const duration = parseInt((document.getElementById('lt-duration') as HTMLInputElement).value) || 10;
    const users = parseInt((document.getElementById('lt-users') as HTMLInputElement).value) || 10;
    if (!url) return;
    document.getElementById('lt-results')!.classList.remove('hidden');
    const btn = document.getElementById('lt-start') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Running...';
    let total = 0, ok = 0, err = 0;
    const endTime = Date.now() + duration * 1000;
    const startTime = Date.now();

    async function fire() {
      while (Date.now() < endTime) {
        try { const r = await fetch(url, { cache: 'no-store' }); r.ok ? ok++ : err++; } catch { err++; }
        total++;
        const elapsed = (Date.now() - startTime) / 1000;
        const pct = Math.min(100, Math.round((elapsed / duration) * 100));
        document.getElementById('lt-total')!.textContent = String(total);
        document.getElementById('lt-ok')!.textContent = String(ok);
        document.getElementById('lt-err')!.textContent = String(err);
        document.getElementById('lt-rps')!.textContent = String(Math.round(total / elapsed));
        (document.getElementById('lt-bar') as HTMLElement).style.width = pct + '%';
        document.getElementById('lt-status')!.textContent = `${Math.round(elapsed)}s / ${duration}s`;
      }
    }
    await Promise.all(Array.from({ length: users }, () => fire()));
    btn.disabled = false; btn.textContent = 'Start Load Test';
    document.getElementById('lt-status')!.textContent = `Completed — ${total} requests in ${duration}s`;
  });
</script>
