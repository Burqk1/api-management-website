---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Log in — Fetchlab</title>
  </head>
  <body class="min-h-screen bg-[#0A0A0B] text-[#F5F5F5] flex items-center justify-center px-6">
    <div class="w-full max-w-[380px]">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 justify-center mb-10">
        <img src="/logo.jpg" alt="Fetchlab" class="w-[24px] h-[24px] rounded-[6px]" />
        <span class="text-[#F5F5F5] font-medium text-[16px] tracking-[-0.01em]">Fetchlab</span>
      </a>

      <h1 class="text-[24px] font-medium tracking-[-0.03em] text-center mb-2">Welcome back</h1>
      <p class="text-[14px] text-[#5C5C5C] text-center mb-8">Log in to your Fetchlab account</p>

      <!-- OAuth buttons -->
      <div class="space-y-2.5 mb-6">
        <button class="auth-oauth-btn" data-provider="google">
          <svg width="16" height="16" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Continue with Google
        </button>
        <button class="auth-oauth-btn" data-provider="github">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#F5F5F5"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          Continue with GitHub
        </button>
        <button class="auth-oauth-btn" data-provider="apple">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#F5F5F5"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          Continue with Apple
        </button>
      </div>

      <!-- Divider -->
      <div class="flex items-center gap-3 mb-6">
        <div class="flex-1 h-px bg-[#1E1E21]"></div>
        <span class="text-[12px] text-[#3A3A3E]">or</span>
        <div class="flex-1 h-px bg-[#1E1E21]"></div>
      </div>

      <!-- Email form -->
      <form id="login-form" class="space-y-3">
        <div>
          <label class="block text-[12px] text-[#5C5C5C] mb-1.5 font-medium">Email</label>
          <input type="email" id="email" required placeholder="you@example.com" class="auth-input" />
        </div>
        <div>
          <label class="block text-[12px] text-[#5C5C5C] mb-1.5 font-medium">Password</label>
          <input type="password" id="password" required placeholder="Enter your password" class="auth-input" />
        </div>

        <div class="flex items-center justify-between pt-1">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" class="w-3.5 h-3.5 rounded border-[#2A2A2E] bg-[#111113] accent-[#FF9500]" />
            <span class="text-[12px] text-[#5C5C5C]">Remember me</span>
          </label>
          <a href="#" class="text-[12px] text-[#5C5C5C] hover:text-[#8B8B8B] transition-colors">Forgot password?</a>
        </div>

        <button type="submit" class="auth-submit-btn mt-2" id="submit-btn">
          Log in
        </button>

        <div id="error-msg" class="hidden text-[12px] text-red-400 text-center pt-1"></div>
      </form>

      <p class="text-center text-[13px] text-[#5C5C5C] mt-8">
        Don't have an account? <a href="/signup" class="text-[#F5F5F5] hover:underline font-medium">Sign up</a>
      </p>
    </div>

    <style>
      .auth-input {
        width: 100%;
        padding: 9px 12px;
        background: #111113;
        border: 1px solid #1E1E21;
        border-radius: 8px;
        color: #F5F5F5;
        font-size: 13px;
        outline: none;
        transition: border-color 0.15s ease;
      }
      .auth-input:focus { border-color: #3A3A3E; }
      .auth-input::placeholder { color: #3A3A3E; }
      .auth-oauth-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        background: #111113;
        border: 1px solid #1E1E21;
        border-radius: 8px;
        color: #F5F5F5;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }
      .auth-oauth-btn:hover { border-color: #2A2A2E; background: #141416; }
      .auth-submit-btn {
        width: 100%;
        padding: 10px 16px;
        background: #F5F5F5;
        color: #0A0A0B;
        font-size: 13px;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: opacity 0.15s ease;
        border: none;
      }
      .auth-submit-btn:hover { opacity: 0.9; }
      .auth-submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    </style>

    <script>
      import { supabase } from '../lib/supabase';

      const form = document.getElementById('login-form') as HTMLFormElement;
      const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

      // No auto-redirect — user must click login explicitly

      // Email/password login
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Signing in...';

        const email = (document.getElementById('email') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;

        const { error } = await supabase.auth.signInWithPassword({ email, password });

        if (error) {
          errorMsg.textContent = error.message;
          errorMsg.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Log in';
        } else {
          window.location.href = '/dashboard';
        }
      });

      // OAuth login
      document.querySelectorAll('.auth-oauth-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const provider = (btn as HTMLElement).dataset.provider as 'google' | 'github' | 'apple';
          await supabase.auth.signInWithOAuth({
            provider,
            options: { redirectTo: `${window.location.origin}/dashboard` },
          });
        });
      });
    </script>
  </body>
</html>
