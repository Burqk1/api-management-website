---
import Base from '../layouts/Base.astro';

const items = [
  {
    title: 'End-to-End Encryption',
    description: 'All cloud-synced data is encrypted using AES-256-GCM before leaving your device. Your encryption keys never touch our servers.',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
  },
  {
    title: 'Zero-Knowledge Architecture',
    description: 'We cannot read, access, or decrypt your data. Even if our servers were compromised, your API keys and tokens remain safe.',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  },
  {
    title: 'Local-First Storage',
    description: 'All requests, collections, and environments are stored locally on your device by default. Cloud sync is entirely optional.',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>',
  },
  {
    title: 'No Telemetry',
    description: 'We do not collect your API requests, responses, headers, or any data you work with. Usage analytics are minimal and anonymized.',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>',
  },
  {
    title: 'Sandboxed Script Execution',
    description: 'Pre/post scripts run in an isolated sandbox with no access to the filesystem, network (beyond the target API), or other apps.',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  },
  {
    title: 'Secure Credential Storage',
    description: 'API keys, tokens, and passwords are stored in the iOS Keychain, protected by the Secure Enclave on supported devices.',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>',
  },
];
---

<Base title="Security — Fetchlab" description="How Fetchlab protects your API data with end-to-end encryption and zero-knowledge architecture.">
  <div class="pt-28 pb-20 px-6">
    <div class="max-w-[780px] mx-auto">
      <h1 class="text-[32px] sm:text-[40px] font-medium tracking-[-0.04em] text-[#F5F5F5] mb-3">Security</h1>
      <p class="text-[15px] text-[#5C5C5C] mb-14 max-w-[520px]">
        Your API data is sensitive. Fetchlab is built from the ground up with security and privacy as core principles.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-[#1E1E21] rounded-xl overflow-hidden border border-[#1E1E21]">
        {items.map((item) => (
          <div class="bg-[#0A0A0B] p-7">
            <div class="text-[#5C5C5C] mb-4">
              <Fragment set:html={item.icon} />
            </div>
            <h3 class="text-[15px] font-medium text-[#F5F5F5] mb-2">{item.title}</h3>
            <p class="text-[13px] text-[#5C5C5C] leading-[1.6]">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
