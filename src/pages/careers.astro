---
import Base from '../layouts/Base.astro';

const openings = [
  {
    title: 'Senior iOS Engineer',
    team: 'Engineering',
    location: 'Remote',
    type: 'Full-time',
  },
  {
    title: 'Backend Engineer (Rust)',
    team: 'Engineering',
    location: 'Remote',
    type: 'Full-time',
  },
  {
    title: 'Product Designer',
    team: 'Design',
    location: 'Remote',
    type: 'Full-time',
  },
];
---

<Base title="Careers — Fetchlab" description="Join the Fetchlab team. We're building the best API testing experience for mobile developers.">
  <div class="pt-28 pb-20 px-6">
    <div class="max-w-[680px] mx-auto">
      <h1 class="text-[32px] sm:text-[40px] font-medium tracking-[-0.04em] text-[#F5F5F5] mb-3">Careers</h1>
      <p class="text-[15px] text-[#8B8B8B] leading-[1.7] mb-14 max-w-[520px]">
        We're a small, remote team building developer tools that respect privacy and don't compromise on quality. If that resonates, we'd love to hear from you.
      </p>

      <h2 class="text-[15px] font-medium text-[#F5F5F5] mb-6 pb-4 border-b border-[#1E1E21]">Open positions</h2>

      {openings.length > 0 ? (
        <div class="space-y-0">
          {openings.map((job) => (
            <a href="#" class="flex items-center justify-between py-5 border-b border-[#1E1E21] group hover:bg-[#111113] -mx-4 px-4 rounded-lg transition-colors">
              <div>
                <div class="text-[15px] font-medium text-[#F5F5F5] mb-1 group-hover:text-white transition-colors">{job.title}</div>
                <div class="flex items-center gap-2 text-[12px] text-[#5C5C5C]">
                  <span>{job.team}</span>
                  <span class="text-[#2A2A2E]">/</span>
                  <span>{job.location}</span>
                  <span class="text-[#2A2A2E]">/</span>
                  <span>{job.type}</span>
                </div>
              </div>
              <svg class="w-4 h-4 text-[#3A3A3E] group-hover:text-[#8B8B8B] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-[14px] text-[#5C5C5C]">No open positions at the moment. Check back soon or send us a note at <a href="mailto:careers@fetchlab.dev" class="text-accent hover:underline">careers@fetchlab.dev</a>.</p>
      )}

      <div class="mt-12 p-6 bg-[#111113] border border-[#1E1E21] rounded-xl">
        <p class="text-[13px] text-[#6B6B6B] leading-relaxed">
          Don't see a role that fits? We're always interested in hearing from talented people. Send your resume and a brief note about what you'd like to work on to <a href="mailto:careers@fetchlab.dev" class="text-accent hover:underline">careers@fetchlab.dev</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
