---
import Base from '../layouts/Base.astro';
---

<Base title="Support — Fetchlab" description="Get help with Fetchlab. Contact support, report bugs, or request features.">
  <div class="pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Support</h1>
      <p class="text-base-400 text-lg mb-16 max-w-xl">Need help? We're here for you. Choose the best way to reach us below.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Email support -->
        <a href="mailto:support@fetchlab.dev" class="card-glow group bg-base-900 border border-base-800 rounded-card p-6 block">
          <div class="w-10 h-10 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF9500" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-base-50 mb-1">Email Support</h3>
          <p class="text-sm text-base-500 mb-3">Get a response within 24 hours.</p>
          <span class="text-sm text-accent">support@fetchlab.dev</span>
        </a>

        <!-- FAQ -->
        <a href="/#faq" class="card-glow group bg-base-900 border border-base-800 rounded-card p-6 block">
          <div class="w-10 h-10 rounded-lg bg-base-800 border border-base-700/50 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A1A1AA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
              <path d="M12 17h.01"/>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-base-50 mb-1">FAQ</h3>
          <p class="text-sm text-base-500 mb-3">Quick answers to common questions.</p>
          <span class="text-sm text-base-400">View FAQ &rarr;</span>
        </a>

        <!-- Bug report -->
        <a href="mailto:bugs@fetchlab.dev?subject=Bug Report: " class="card-glow group bg-base-900 border border-base-800 rounded-card p-6 block">
          <div class="w-10 h-10 rounded-lg bg-base-800 border border-base-700/50 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A1A1AA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m8 2 1.88 1.88M14.12 3.88 16 2M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/>
              <path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/>
              <path d="M12 20v-9M6.53 9C4.6 8.8 3 7.1 3 5M6 13H2M6 17H3M21 5c0 2.1-1.6 3.8-3.53 4M22 13h-4M21 17h-3"/>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-base-50 mb-1">Report a Bug</h3>
          <p class="text-sm text-base-500 mb-3">Found something broken? Let us know.</p>
          <span class="text-sm text-base-400">bugs@fetchlab.dev</span>
        </a>

        <!-- Feature request -->
        <a href="mailto:feedback@fetchlab.dev?subject=Feature Request: " class="card-glow group bg-base-900 border border-base-800 rounded-card p-6 block">
          <div class="w-10 h-10 rounded-lg bg-base-800 border border-base-700/50 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A1A1AA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l1.5 4.5H18l-3.5 2.5L16 14.5 12 11.5 8 14.5l1.5-4.5L6 7.5h4.5z"/>
              <path d="M12 17v4"/>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-base-50 mb-1">Request a Feature</h3>
          <p class="text-sm text-base-500 mb-3">Have an idea? We'd love to hear it.</p>
          <span class="text-sm text-base-400">feedback@fetchlab.dev</span>
        </a>
      </div>
    </div>
  </div>
</Base>
