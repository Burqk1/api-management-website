---
import Dashboard from './Dashboard.astro';

interface Props {
  title: string;
  description: string;
  color: string;
}

const { title, description, color } = Astro.props;
---

<Dashboard title={title} activeTab="tools">
  <!-- Tool header -->
  <div class="flex items-center gap-4 mb-6">
    <a href="/dashboard/tools" class="p-2 rounded-lg hover:bg-white/[0.04] text-white/30 hover:text-white/60 transition-all">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </a>
    <div class="flex items-center gap-3">
      <div class="w-3 h-3 rounded-full" style={`background: ${color}; box-shadow: 0 0 12px ${color}40;`}></div>
      <div>
        <h1 class="text-[20px] font-semibold tracking-[-0.03em] text-white/90">{title}</h1>
        <p class="text-[12px] text-white/30 mt-0.5">{description}</p>
      </div>
    </div>
  </div>

  <!-- Tool content -->
  <slot />
</Dashboard>

<!-- Pro gate script — checks plan, redirects if free -->
<script>
  import { supabase } from '../lib/supabase';

  async function checkPro() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const { data } = await supabase
      .from('profiles')
      .select('plan')
      .eq('id', session.user.id)
      .single();

    if (!data || data.plan === 'free') {
      window.location.href = '/dashboard/tools/pro-required';
    }
  }

  checkPro();
</script>
