---
import '../styles/global.css';

interface Props {
  title: string;
  activeTab: string;
}

const { title, activeTab } = Astro.props;

const navItems = [
  { id: 'overview', label: 'Dashboard', icon: 'dashboard', href: '/dashboard' },
  { id: 'apis', label: 'APIs', icon: 'api', href: '/dashboard/apis' },
  { id: 'monitor', label: 'Monitor', icon: 'monitor', href: '/dashboard/monitor' },
  { id: 'tools', label: 'Tools', icon: 'tools', href: '/dashboard/tools' },
  { id: 'environments', label: 'Environments', icon: 'env', href: '/dashboard/environments' },
  { id: 'history', label: 'History', icon: 'history', href: '/dashboard/history' },
];

const bottomItems = [
  { id: 'settings', label: 'Settings', icon: 'settings', href: '/dashboard/settings' },
];

const icons: Record<string, string> = {
  dashboard: '<path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>',
  api: '<path d="M14 12l-2 2-2-2 2-2 2 2zm-2-6l2.12 2.12 2.5-2.5L12 1 7.38 5.62l2.5 2.5L12 6zm-6 6l2.12-2.12-2.5-2.5L1 12l4.62 4.62 2.5-2.5L6 12zm12 0l-2.12 2.12 2.5 2.5L23 12l-4.62-4.62-2.5 2.5L18 12zm-6 6l-2.12-2.12-2.5 2.5L12 23l4.62-4.62-2.5-2.5L12 18z"/>',
  monitor: '<path d="M19.5 3.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2v14H3v3c0 1.66 1.34 3 3 3h12c1.66 0 3-1.34 3-3V2l-1.5 1.5zM19 19c0 .55-.45 1-1 1s-1-.45-1-1v-3H8V5h11v14z"/><path d="M9 7h6v2H9zm0 3h6v2H9z"/>',
  tools: '<path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>',
  env: '<path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>',
  history: '<path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/>',
  settings: '<path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090B" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title} — Fetchlab</title>
    <!-- Prevent flash of untranslated content -->
    <script is:inline>
      (function() {
        try {
          var s = JSON.parse(localStorage.getItem('fl_settings') || '{}');
          if (s.language && s.language !== 'en') {
            document.documentElement.setAttribute('data-lang', s.language);
            document.documentElement.style.visibility = 'hidden';
          }
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="h-screen bg-[#09090B] text-[#FAFAFA] overflow-hidden" style="font-family: 'DM Sans', system-ui, sans-serif;">
    <div class="flex h-full">
      <!-- Sidebar -->
      <aside class="db-sidebar hidden lg:flex">
        <!-- Logo area -->
        <div class="h-14 flex items-center px-4 border-b border-white/[0.06]">
          <a href="/" class="flex items-center gap-2.5 group">
            <img src="/logo.jpg" alt="Fetchlab" class="w-7 h-7 rounded-lg shadow-lg shadow-orange-500/20 group-hover:shadow-orange-500/30 transition-shadow" />
            <span class="text-[14px] font-semibold tracking-[-0.02em] text-white/90">Fetchlab</span>
            <span class="ml-auto text-[10px] font-medium text-white/20 bg-white/[0.04] px-1.5 py-0.5 rounded">v1.0</span>
          </a>
        </div>

        <!-- Search -->
        <div class="px-3 pt-3 pb-1">
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.06] text-white/30 text-[12px] cursor-pointer hover:bg-white/[0.05] hover:border-white/[0.08] transition-all">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <span data-i18n="nav.search">Search...</span>
            <kbd class="ml-auto text-[10px] bg-white/[0.06] text-white/25 px-1.5 py-0.5 rounded font-mono">⌘K</kbd>
          </div>
        </div>

        <!-- Main nav -->
        <nav class="flex-1 px-2 py-2 space-y-0.5 overflow-y-auto">
          <div class="px-3 pt-2 pb-1.5">
            <span class="text-[10px] font-semibold text-white/20 uppercase tracking-[0.08em]" data-i18n="nav.main">Main</span>
          </div>
          {navItems.map((item) => (
            <a href={item.href} class={`db-nav-item ${activeTab === item.id ? 'active' : ''}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="opacity-50">
                <Fragment set:html={icons[item.icon]} />
              </svg>
              <span data-i18n={`nav.${item.id}`}>{item.label}</span>
              {item.id === 'apis' && <span class="db-nav-badge">3</span>}
            </a>
          ))}

          <div class="px-3 pt-4 pb-1.5">
            <span class="text-[10px] font-semibold text-white/20 uppercase tracking-[0.08em]" data-i18n="nav.system">System</span>
          </div>
          {bottomItems.map((item) => (
            <a href={item.href} class={`db-nav-item ${activeTab === item.id ? 'active' : ''}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="opacity-50">
                <Fragment set:html={icons[item.icon]} />
              </svg>
              <span data-i18n={`nav.${item.id}`}>{item.label}</span>
            </a>
          ))}
        </nav>

        <!-- Sync status -->
        <div class="px-3 py-2 border-t border-white/[0.06]">
          <div class="flex items-center gap-2 px-2 py-1.5 text-[11px] text-white/30">
            <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" id="sync-dot"></div>
            <span id="sync-label" data-i18n="nav.synced">Synced</span>
          </div>
        </div>

        <!-- User section -->
        <div class="border-t border-white/[0.06] p-3">
          <div class="flex items-center gap-2.5 px-2 py-2 rounded-lg hover:bg-white/[0.04] transition-colors cursor-pointer group">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-violet-500 to-fuchsia-500 flex items-center justify-center text-[11px] font-bold text-white ring-2 ring-white/[0.06]" id="user-avatar">?</div>
            <div class="flex-1 min-w-0">
              <div class="text-[12px] font-medium text-white/80 truncate" id="user-email">Loading...</div>
              <div class="text-[10px] text-white/25" id="user-plan">Free Plan</div>
            </div>
            <button class="opacity-0 group-hover:opacity-100 p-1 rounded hover:bg-white/[0.06] transition-all" id="logout-btn" title="Log out">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40 hover:text-red-400 transition-colors"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            </button>
          </div>
        </div>
      </aside>

      <!-- Main area -->
      <div class="flex-1 flex flex-col min-w-0">
        <!-- Top bar -->
        <header class="h-14 flex items-center justify-between px-6 border-b border-white/[0.06] bg-[#09090B]/80 backdrop-blur-xl sticky top-0 z-30 shrink-0">
          <div class="flex items-center gap-3">
            <!-- Mobile menu -->
            <button id="mobile-menu-btn" class="lg:hidden p-1.5 rounded-lg hover:bg-white/[0.06] text-white/50 transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <!-- Mobile logo -->
            <a href="/" class="lg:hidden flex items-center gap-2">
              <img src="/logo.jpg" alt="Fetchlab" class="w-6 h-6 rounded-md" />
            </a>
            <!-- Breadcrumb -->
            <div class="hidden sm:flex items-center gap-1.5 text-[13px]">
              <span class="text-white/25">Fetchlab</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white/15"><path d="M9 18l6-6-6-6"/></svg>
              <span class="text-white/70 font-medium">{title}</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button class="db-topbar-btn" title="Notifications">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </button>
            <button class="db-topbar-btn" title="Help">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </button>
          </div>
        </header>

        <!-- Content -->
        <main class="flex-1 overflow-y-auto">
          <div class="max-w-[1200px] mx-auto px-6 py-8">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <!-- Mobile nav overlay -->
    <div id="mobile-nav" class="fixed inset-0 z-50 hidden lg:hidden">
      <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="mobile-nav-backdrop"></div>
      <aside class="db-sidebar !flex w-[280px] relative z-10 shadow-2xl shadow-black/50">
        <div class="h-14 flex items-center justify-between px-4 border-b border-white/[0.06]">
          <a href="/" class="flex items-center gap-2.5">
            <img src="/logo.jpg" alt="Fetchlab" class="w-7 h-7 rounded-lg" />
            <span class="text-[14px] font-semibold text-white/90">Fetchlab</span>
          </a>
          <button id="mobile-close-btn" class="p-1.5 rounded-lg hover:bg-white/[0.06] text-white/40">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <nav class="flex-1 px-2 py-3 space-y-0.5">
          {navItems.map((item) => (
            <a href={item.href} class={`db-nav-item ${activeTab === item.id ? 'active' : ''}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="opacity-50"><Fragment set:html={icons[item.icon]} /></svg>
              <span>{item.label}</span>
            </a>
          ))}
          <div class="border-t border-white/[0.06] my-2"></div>
          {bottomItems.map((item) => (
            <a href={item.href} class={`db-nav-item ${activeTab === item.id ? 'active' : ''}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="opacity-50"><Fragment set:html={icons[item.icon]} /></svg>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="border-t border-white/[0.06] p-3">
          <button class="db-nav-item w-full text-red-400/70 hover:text-red-400 hover:bg-red-500/[0.06]" id="mobile-logout-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            <span>Log out</span>
          </button>
        </div>
      </aside>
    </div>

    <style is:global>
      /* Dashboard sidebar */
      .db-sidebar {
        width: 240px;
        flex-shrink: 0;
        flex-direction: column;
        height: 100%;
        background: linear-gradient(180deg, #0C0C0F 0%, #09090B 100%);
        border-right: 1px solid rgba(255,255,255,0.06);
      }

      /* Nav items */
      .db-nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        color: rgba(255,255,255,0.45);
        transition: all 0.15s ease;
        cursor: pointer;
        border: 1px solid transparent;
        background: none;
        text-align: left;
        width: 100%;
        text-decoration: none;
      }
      .db-nav-item:hover {
        color: rgba(255,255,255,0.8);
        background: rgba(255,255,255,0.04);
      }
      .db-nav-item.active {
        color: rgba(255,255,255,0.95);
        background: rgba(255,255,255,0.07);
        border-color: rgba(255,255,255,0.06);
        box-shadow: 0 1px 2px rgba(0,0,0,0.2);
      }
      .db-nav-item.active svg { opacity: 0.9; }

      .db-nav-badge {
        margin-left: auto;
        font-size: 10px;
        font-weight: 600;
        background: rgba(255,149,0,0.15);
        color: #FF9500;
        padding: 1px 6px;
        border-radius: 10px;
      }

      .db-topbar-btn {
        padding: 7px;
        border-radius: 8px;
        color: rgba(255,255,255,0.35);
        transition: all 0.15s ease;
        border: 1px solid transparent;
        background: none;
        cursor: pointer;
      }
      .db-topbar-btn:hover {
        color: rgba(255,255,255,0.7);
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.06);
      }

      /* Dashboard cards */
      .db-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 20px;
        transition: border-color 0.2s ease;
      }
      .db-card:hover {
        border-color: rgba(255,255,255,0.1);
      }
      .db-card-header {
        font-size: 13px;
        font-weight: 600;
        color: rgba(255,255,255,0.5);
        letter-spacing: -0.01em;
        margin-bottom: 16px;
      }

      /* Scrollbar */
      .db-sidebar::-webkit-scrollbar,
      main::-webkit-scrollbar {
        width: 4px;
      }
      .db-sidebar::-webkit-scrollbar-track,
      main::-webkit-scrollbar-track {
        background: transparent;
      }
      .db-sidebar::-webkit-scrollbar-thumb,
      main::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.08);
        border-radius: 2px;
      }

      /* Font */
      code, pre, .font-mono, kbd {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>

    <script>
      import { supabase } from '../lib/supabase';
      import { loadLocal, fullSync } from '../lib/syncStore';
      import { applyTranslations } from '../lib/i18n';

      // Auth guard
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        document.documentElement.style.visibility = 'visible';
        window.location.href = '/login';
      } else {
        const email = session.user.email || '';
        const avatar = email.charAt(0).toUpperCase();
        document.querySelectorAll('#user-email').forEach(el => el.textContent = email);
        document.querySelectorAll('#user-avatar').forEach(el => el.textContent = avatar);

        // Load local data first (instant)
        loadLocal();

        // Apply translations immediately from localStorage, then show page
        applyTranslations();
        document.documentElement.style.visibility = 'visible';

        // Sync from cloud in background
        fullSync().then((ok) => {
          if (ok) window.dispatchEvent(new CustomEvent('fetchlab:synced'));
        });
      }

      // Logout
      const handleLogout = async () => {
        await supabase.auth.signOut();
        ['fl_collections','fl_endpoints','fl_call_logs','fl_environments','fl_monitor','fl_api_keys','fl_settings'].forEach(k => localStorage.removeItem(k));
        window.location.href = '/login';
      };
      document.getElementById('logout-btn')?.addEventListener('click', handleLogout);
      document.getElementById('mobile-logout-btn')?.addEventListener('click', handleLogout);

      // Mobile nav
      const mobileNav = document.getElementById('mobile-nav');
      document.getElementById('mobile-menu-btn')?.addEventListener('click', () => mobileNav?.classList.remove('hidden'));
      document.getElementById('mobile-close-btn')?.addEventListener('click', () => mobileNav?.classList.add('hidden'));
      document.getElementById('mobile-nav-backdrop')?.addEventListener('click', () => mobileNav?.classList.add('hidden'));
    </script>
  </body>
</html>
